# Optional overrides; defaults: <repo>/data and core/cache
# DATA_DIR=/abs/path/to/data
# CACHE_DIR=/abs/path/to/cache
PATIENT_ID=0000-0001
# GOOGLE_API_KEY or GEMINI_API_KEY (the repo-root .env is read too)
GOOGLE_API_KEY=
# CLAUDE_API_KEY or ANTHROPIC_API_KEY, for claude- runtime models
CLAUDE_API_KEY=

# Model identifiers  (checked 2026-10-29: 2.5 models are closed to new keys)
# Haiku 5.5 without thinking: 58-59 of 69 eval questions, every screen under 8 s.
# Fastest: gemini-3.5-flash-lite (under 3 s, 49 of 69). Opus 5.5: RUNTIME_THINKING_BUDGET=-1, RUNTIME_EFFORT=low
RUNTIME_MODEL=claude-haiku-5-5
RUNTIME_THINKING_LEVEL=minimal
# Token budget instead of a level (0 = no thinking where allowed, -1 = unset)
RUNTIME_THINKING_BUDGET=0
# Claude only: low | medium | high; empty = model default
RUNTIME_EFFORT=
PREPROCESS_MODEL=gemini-4-argon

# Set true in CI to use canned responses (no API key needed)
LLM_FAKE=false

# Optional: run an extra LLM sweep for contradictions
CONTRADICTION_LLM_SWEEP=false

# auto = date of the latest document for the patient
REFERENCE_DATE=auto
